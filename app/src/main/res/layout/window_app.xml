<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="8dp"
    android:theme="@style/Theme.Material3.DayNight">

    <!-- Content card (holds the VirtualDisplay surface + control overlays) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="invisible"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <SurfaceView
                android:id="@+id/viewSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextureView
                android:id="@+id/viewTexture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Top pill: transparent touch target (drag / tap / double-tap) -->
            <View
                android:id="@+id/topPillTouch"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_gravity="top"
                android:background="@android:color/transparent" />

            <!-- Top pill: visual handle -->
            <View
                android:id="@+id/topPill"
                android:layout_width="64dp"
                android:layout_height="5dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="4dp"
                android:background="@drawable/bar_corners_bg" />

            <!-- Quick toolbar (fullscreen / edge-hide / close), auto-hides -->
            <LinearLayout
                android:id="@+id/quickToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnFullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/fullscreen_desc"
                    android:padding="10dp"
                    android:src="@drawable/ic_maximize" />

                <ImageButton
                    android:id="@+id/btnEdgeHide"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/collapse"
                    android:padding="10dp"
                    android:src="@drawable/ic_collapse" />

                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close_desc"
                    android:padding="10dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- Bottom bar: transparent touch target (tap=back, fling up=close, fling down=fullscreen) -->
            <View
                android:id="@+id/bottomBarTouch"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent" />

            <!-- Bottom-left resize handle -->
            <View
                android:id="@+id/bottomLeftResize"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|start"
                android:background="@android:color/transparent"
                android:contentDescription="@string/resize_desc" />

            <!-- Bottom-right resize handle -->
            <View
                android:id="@+id/bottomRightResize"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:background="@android:color/transparent"
                android:contentDescription="@string/resize_desc" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
